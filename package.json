{
  "name": "bline-web",
  "private": true,
  "version": "1.0.0-beta.1",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "parity": "vitest run --config vitest.parity.config.ts parity-harness/parity.test.ts",
    "validate:bline-lib-io": "vitest run --config vitest.parity.config.ts parity-harness/bline-lib-io.test.ts --testTimeout 360000",
    "test:e2e": "playwright test",
    "test:offline": "npm run build && playwright test --config playwright.offline.config.ts",
    "build": "tsc -b && vite build",
    "release:check": "node scripts/release-check.mjs",
    "release:notes": "node scripts/write-release-notes.mjs",
    "release:windows-msi-config": "node scripts/write-windows-msi-config.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:beta": "node scripts/build-beta.mjs web",
    "tauri:build:beta": "node scripts/build-beta.mjs desktop",
    "test:release": "node --test tests/release/*.test.mjs",
    "release:metadata": "node scripts/release-metadata.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-opener": "2.5.5",
    "lucide-react": "^0.468.0",
    "pixi.js": "8.18.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.10",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.5",
    "workbox-build": "7.4.1"
  }
}
