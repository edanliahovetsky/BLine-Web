{
  "name": "bline-web",
  "private": true,
  "version": "0.1.0-alpha.2",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\" --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "test": "vitest run",
    "parity": "vitest run parity-harness",
    "validate:bline-lib-io": "vitest run --config vitest.bline-lib-io.config.ts",
    "test:e2e": "playwright test",
    "build": "tsc -b --emitDeclarationOnly && vite build",
    "release:check": "node scripts/release-check.mjs",
    "release:notes": "node scripts/write-release-notes.mjs",
    "release:windows-msi-config": "node scripts/write-windows-msi-config.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "pixi.js": "8.18.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
